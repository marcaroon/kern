# Copy to .env. All examples below are placeholders, never live credentials.
NODE_ENV=development
# Required for dashboard mutation origin checks; use HTTPS in production. On Vercel it
# defaults to the project's production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required at runtime: Supabase PostgreSQL server connection. Hosted/serverless: use the
# transaction pooler (port 6543). Locally the session pooler with sslmode=verify-full works.
DATABASE_URL=
# Required for migrations: direct connection or session pooler (port 5432). On Vercel,
# setting it makes `vercel-build` apply pending migrations automatically.
DIRECT_URL=
# Hosted only: Supabase CA certificate PEM (Project Settings > Database > SSL). Replaces a
# local sslrootcert file; certificate and hostname verification stay enabled.
DATABASE_CA_CERT=
# Required for login: Supabase project URL and public anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required: UUID of the single authorized Supabase Auth user.
KERN_OWNER_SUPABASE_USER_ID=

# Telegram bot from @BotFather; required to receive/send chat messages. Keep private.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot; first receives reports.
TELEGRAM_OWNER_USER_ID=
# polling (worker calls getUpdates, no public URL) or webhook (hosted). Empty: webhook on
# Vercel, polling elsewhere. While TELEGRAM_OWNER_USER_ID is empty the bot replies with the
# sender's own ID (setup mode) and stores nothing.
TELEGRAM_MODE=polling
# Webhook mode only: random secret, at least 32 characters (A-Z a-z 0-9 _ -).
TELEGRAM_WEBHOOK_SECRET=

# Optional AI. Groq is recommended for this setup; key stays server-side.
# AI_PROVIDER=groq|openai|anthropic|gemini selects explicitly, or a list tried in order
# (groq,gemini: Groq's free tier allows ~3-4 chat messages per minute). Empty selects the
# first configured provider. Unconfigured listed providers are skipped, never replaced.
AI_PROVIDER=groq
GROQ_API_KEY=
# Must support strict JSON Schema output. Never use a NEXT_PUBLIC_ prefix for keys.
GROQ_MODEL=openai/gpt-oss-20b
# Receipt photos need a model that reads images; Groq's text models cannot. Check the
# Groq vision docs for current IDs, e.g. qwen/qwen3.8-27b. Empty: photos are refused.
GROQ_VISION_MODEL=
# Optional: providers for receipt photos, tried in order (e.g. groq,gemini: Groq's free
# tier reads about one receipt per minute, Gemini takes over when it is rate limited).
# Empty uses AI_PROVIDER. OPENAI/ANTHROPIC/GEMINI_VISION_MODEL default to <P>_MODEL.
AI_VISION_PROVIDER=
OPENAI_API_KEY=
# A Responses API model supporting Structured Outputs, available to your account.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# A Claude model supporting structured outputs, e.g. claude-opus-5-5.
ANTHROPIC_MODEL=
# Google AI Studio key. Free tier: Google may use prompts/outputs to improve its products.
GEMINI_API_KEY=
# A Gemini model supporting JSON-schema output, e.g. a Gemini 3 Flash model ID.
GEMINI_MODEL=

# Optional together; finance remains available without Sheets.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Single-line JSON; keep private_key newline escapes intact. Never expose client-side.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Required for n8n/internal endpoints: random secret, at least 32 characters.
KERN_INTERNAL_API_SECRET=
# Default timezone for chat dates and reports. Dashboard currently uses WIB.
TIME_ZONE=Asia/Jakarta
# Schedule reference values; configure matching n8n Schedule Trigger expressions.
KERN_DAILY_BRIEFING_TIME=07:00
KERN_WEEKLY_REVIEW_DAY=SUNDAY
KERN_WEEKLY_REVIEW_TIME=20:00
# Processed message content is redacted after this many days by maintenance job.
KERN_LOG_RETENTION_DAYS=30
# Opt-in only for db:seed; refuses production and requires a database name containing demo.
KERN_ALLOW_DEMO_SEED=false
