generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String        @id @default(uuid())
  ownerId      String
  name         String
  transactions Transaction[] @relation("FromAccount")
  transfers    Transaction[] @relation("ToAccount")
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([ownerId, name])
}

model Transaction {
  id            String            @id @default(uuid())
  ownerId       String
  type          String
  amount        BigInt
  occurredAt    DateTime          @db.Timestamptz(3)
  category      String
  description   String
  paymentMethod String?
  accountId     String?
  account       Account?          @relation("FromAccount", fields: [accountId], references: [id])
  toAccountId   String?
  toAccount     Account?          @relation("ToAccount", fields: [toAccountId], references: [id])
  source        String            @default("dashboard")
  messageId     String?
  status        String            @default("active")
  revision      Int               @default(1)
  sheetRow      Int               @unique @default(autoincrement())
  syncs         SheetSyncOutbox[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([ownerId, occurredAt])
  @@index([ownerId, category, status])
}

model Budget {
  id             String   @id @default(uuid())
  ownerId        String
  month          String
  category       String
  amount         BigInt
  warningPercent Int      @default(80)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([ownerId, month, category])
}

model BudgetAlert {
  id        String   @id @default(uuid())
  ownerId   String
  month     String
  category  String
  threshold Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([ownerId, month, category, threshold])
}

model Task {
  id          String     @id @default(uuid())
  ownerId     String
  title       String
  description String?
  status      String     @default("open")
  priority    Int        @default(2)
  dueAt       DateTime?  @db.Timestamptz(3)
  project     String?
  completedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  reminders   Reminder[]

  @@index([ownerId, status, dueAt])
}

model Reminder {
  id               String    @id @default(uuid())
  ownerId          String
  title            String
  message          String?
  scheduledAt      DateTime  @db.Timestamptz(3)
  timezone         String    @default("Asia/Jakarta")
  recurrence       String    @default("once")
  anchorDay        Int
  nextRunAt        DateTime? @db.Timestamptz(3)
  status           String    @default("active")
  deliveryStatus   String    @default("pending")
  lastDeliveredAt  DateTime? @db.Timestamptz(3)
  lastOccurrenceAt DateTime? @db.Timestamptz(3)
  lastError        String?
  taskId           String?
  task             Task?     @relation(fields: [taskId], references: [id])
  generation       Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextRunAt])
  @@index([ownerId])
}

model Note {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  content   String
  tags      String[] @default([])
  category  String   @default("general")
  project   String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ownerId, archived, createdAt])
}

model InboxMessage {
  id          String    @id
  ownerId     String
  sender      String
  text        String
  receivedAt  DateTime  @db.Timestamptz(3)
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  lastError   String?
  processedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
}

model Job {
  id          String    @id @default(uuid())
  key         String    @unique
  ownerId     String
  kind        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt   DateTime? @db.Timestamptz(3)
  providerId  String?   @unique
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([ownerId, kind])
}

model SheetSyncOutbox {
  id            String      @id @default(uuid())
  ownerId       String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  revision      Int
  status        String      @default("pending")
  attempts      Int         @default(0)
  availableAt   DateTime    @default(now()) @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([transactionId, revision])
  @@index([status, availableAt])
}

model PendingAction {
  id         String    @id @default(uuid())
  ownerId    String
  payload    Json
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([ownerId, expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  ownerId   String
  action    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerId, createdAt])
}
